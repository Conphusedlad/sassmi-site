{%- comment -%}
  Admin-made pages. The policy handles (privacy, terms, shipping, refunds, grievance) and crunchy-makhana are app routes —
  layout/theme.liquid redirects them; any other page renders its own content in the brand shell.
{%- endcomment -%}
{%- unless page.handle == 'privacy' or page.handle == 'terms' or page.handle == 'shipping' or page.handle == 'refunds' or page.handle == 'grievance' or page.handle == 'crunchy-makhana' -%}
<article>
  <h1>{{ page.title }}</h1>
  {{ page.content }}
</article>
{%- endunless -%}
