{%- comment -%}
  Sassmi — Shopify theme shell. Generated into dist-shopify/theme by scripts/shopify-theme.ts; the source is
  scripts/shopify-theme/layout/theme.liquid. The storefront is the React app (assets/sassmi.js + sassmi.css);
  it mounts into #root and routes by hash (/#/product/…), so every Shopify URL rendered through this layout
  is sent to the matching app route below. Shopify keeps /cart (Ajax), /checkout, /account and /password.
{%- endcomment -%}
{%- liquid
  assign sassmi_root = routes.root_url
  assign sassmi_title = 'Sassmi — Premium Makhana, Rooted in Mithila'
  assign sassmi_description = 'Sassmi premium makhana — twelve roasted flavours and a ready-to-serve kheer. Sourced from the ponds of Mithila, made in small batches in New Delhi.'
  assign sassmi_og_title = 'Sassmi — Premium Makhana'
  assign sassmi_og_description = 'Rooted in Mithila. Crafted for today. Thirteen flavours of premium makhana.'
  assign sassmi_og_image = 'img-art-lineup-v2.webp' | asset_url
  if template.name != 'index' and page_title != blank
    assign sassmi_title = page_title | append: ' — Sassmi'
  endif
  if template.name == 'product' and product
    assign sassmi_og_title = product.title | append: ' — Sassmi'
    assign sassmi_og_description = product.description | strip_html | truncate: 160
    assign sassmi_description = sassmi_og_description
    if product.featured_image
      assign sassmi_og_image = product.featured_image | image_url: width: 1200
    endif
  endif
  unless sassmi_og_image contains 'https:'
    assign sassmi_og_image = sassmi_og_image | prepend: 'https:'
  endunless

  # Which URLs mount the app. Shopify pages we don't know (an extra page made in the admin,
  # the legal policies, a blog) render their own content inside the brand shell further down instead.
  assign sassmi_app = false
  assign sassmi_app_page = false
  case template.name
    when 'index' or 'product' or 'collection' or 'list-collections' or 'cart' or '404' or 'search'
      assign sassmi_app = true
    when 'page'
      if page.handle == 'privacy' or page.handle == 'terms' or page.handle == 'shipping' or page.handle == 'refunds' or page.handle == 'grievance' or page.handle == 'crunchy-makhana'
        assign sassmi_app = true
        assign sassmi_app_page = true
      endif
  endcase
  if template.directory == 'customers'
    assign sassmi_app = true
  endif
-%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0F1A30">
    <title>{{ sassmi_title }}</title>
    <meta name="description" content="{{ sassmi_description | escape }}">
    <meta property="og:title" content="{{ sassmi_og_title | escape }}">
    <meta property="og:description" content="{{ sassmi_og_description | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ sassmi_og_image }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&family=Kaushan+Script&display=swap" rel="stylesheet">
    {%- if sassmi_app %}
    <link rel="stylesheet" href="{{ 'sassmi.css' | asset_url }}">
    <script>
      // Written by scripts/shopify-theme.ts: public path → CDN URL. The app resolves every image through it (src/lib/env.ts → asset()).
      window.SASSMI_ASSETS = {
<!--SASSMI_ASSET_MAP-->
      };
      window.SASSMI_SHOP = {
        template: {{ template.name | json }},
        handle: {% if template.name == 'product' and product %}{{ product.handle | json }}{% elsif template.name == 'page' and page %}{{ page.handle | json }}{% elsif template.name == 'collection' and collection %}{{ collection.handle | json }}{% else %}null{% endif %},
        root: {{ routes.root_url | json }},
        cartUrl: {{ routes.cart_url | json }},
        currency: {{ cart.currency.iso_code | json }},
        cartCount: {{ cart.item_count | default: 0 }},
        moneyFormat: {{ shop.money_format | json }},
        domain: {{ shop.url | json }}
      };
      (function () {
        // Shopify renders its own URLs through this layout; send each to the app route, keeping the query string (utm_*, preview params).
        var root = {{ sassmi_root | json }};
        var q = location.search;
        var go = function (hash, extra) {
          var search = extra ? '?' + extra + (q ? '&' + q.slice(1) : '') : q;
          location.replace(root + search + hash);
        };
        {%- case template.name %}
          {%- when 'product' %}
            {%- if product %}go('#/product/{{ product.handle }}');{% endif %}
          {%- when 'cart' %}
            go('#/', 'cart=open');
          {%- when 'page' %}
            {%- if sassmi_app_page %}{% if page.handle == 'crunchy-makhana' %}go('#/crunchy-makhana');{% else %}go('#/policies/{{ page.handle }}');{% endif %}{% endif %}
          {%- when '404' %}
            // old own-site links keep working (/product/x, /policies/x); Shopify's policy URLs map to the app's policy pages; anything else → the app's 404
            var p = location.pathname.replace(/\/+$/, '');
            var policies = { 'privacy-policy': 'privacy', 'terms-of-service': 'terms', 'shipping-policy': 'shipping', 'refund-policy': 'refunds', 'legal-notice': 'terms', 'contact-information': 'grievance' };
            var m = p.match(/^\/policies\/([a-z-]+)$/);
            if (m && policies[m[1]]) p = '/policies/' + policies[m[1]];
            var known = /^\/(product\/[a-z0-9-]+|crunchy-makhana|policies\/[a-z-]+)$/.test(p);
            go(known ? '#' + p : '#/404');
          {%- when 'collection' or 'list-collections' or 'search' %}
            go('#/');
        {%- endcase %}
        {%- if template.directory == 'customers' %}go('#/');{% endif %}
      })();
    </script>
    <script type="module" src="{{ 'sassmi.js' | asset_url }}"></script>
    {%- else %}
    <style>
      /* Shell for pages Shopify renders itself (admin-made pages, legal policies, blog): the brand palette, nothing more. */
      :root { --night: #0F1A30; --ivory: #F4EEE1; --ink: #1A1A1A; --ink-soft: #4A4A4A; --gold: #C9A867; --gold-deep: #9C7D3C; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ivory); color: var(--ink); font-family: Jost, ui-sans-serif, system-ui, sans-serif; font-weight: 300; line-height: 1.65; -webkit-font-smoothing: antialiased; }
      .sassmi-shell { max-width: 46rem; margin: 0 auto; padding: 40px 24px 80px; }
      .sassmi-shell__nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 28px; border-bottom: 1px solid rgba(15,26,48,.12); }
      .sassmi-shell__nav img { width: 128px; height: auto; }
      .sassmi-shell__nav a { color: var(--gold-deep); text-decoration: none; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }
      .sassmi-shell h1, .sassmi-shell h2, .sassmi-shell h3 { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 500; line-height: 1.15; text-wrap: balance; }
      .sassmi-shell h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 40px 0 20px; }
      .sassmi-shell a { color: var(--gold-deep); }
      .sassmi-shell img { max-width: 100%; height: auto; }
      .sassmi-shell table { border-collapse: collapse; width: 100%; } .sassmi-shell td, .sassmi-shell th { border-bottom: 1px solid rgba(15,26,48,.12); padding: 8px 10px; text-align: left; }
      .sassmi-shell footer { margin-top: 56px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); }
    </style>
    {%- endif %}
    {{ content_for_header }}
  </head>
  <body>
    {%- if sassmi_app %}
    <div id="root"></div>
    {{ content_for_layout }}
    {%- else %}
    <main class="sassmi-shell">
      <nav class="sassmi-shell__nav">
        <a href="{{ routes.root_url }}" aria-label="Sassmi home"><img src="{{ 'img-brand-wordmark-600.webp' | asset_url }}" alt="Sassmi"></a>
        <a href="{{ routes.root_url }}">Back to the shop</a>
      </nav>
      {{ content_for_layout }}
      <footer>Sassmi™ · New Delhi</footer>
    </main>
    {%- endif %}
  </body>
</html>
