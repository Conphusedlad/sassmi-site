# ── Copy to .env (local) or paste into Vercel → Settings → Environment Variables ──

# Razorpay (Dashboard → Account & Settings → API Keys). Test keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → your endpoint https://<domain>/api/razorpay/webhook → the secret you typed there
RAZORPAY_WEBHOOK_SECRET=

# Database. Leave empty locally → uses a SQLite file at ./data/sassmi.sqlite (Bun).
# On Vercel: Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=

# Admin panel password for /admin (choose something long)
ADMIN_PASSWORD=

# Where order/query notifications go (comma-separated allowed)
NOTIFY_EMAIL=crunchymakhanaa@gmail.com

# Email sending — option A: Resend (resend.com → API Keys). FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM="Sassmi <orders@sassmiglobal.com>"
# Email sending — option B: Gmail SMTP with an App Password (Google Account → Security → 2-Step → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public site URL (used in emails)
SITE_URL=http://localhost:5173
