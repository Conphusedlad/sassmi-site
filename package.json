{
  "name": "sassmi-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/dev.ts & vite",
    "dev:web": "vite",
    "dev:api": "bun run --hot server/dev.ts",
    "build": "vite build",
    "build:artifact": "VITE_TARGET=artifact vite build --mode artifact",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:pages": "VITE_TARGET=artifact vite build --mode artifact --outDir docs && touch docs/.nojekyll"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "framer-motion": "^13.4.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}