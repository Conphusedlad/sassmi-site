{% layout none %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }} gift card</title>
    <style>body{font-family:Jost,system-ui,sans-serif;background:#F4EEE1;color:#1A1A1A;margin:0;padding:48px 24px;text-align:center}h1{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500}code{font-size:1.4rem;letter-spacing:.1em}</style>
    {{ content_for_header }}
  </head>
  <body>
    <h1>{{ shop.name }} gift card</h1>
    <p>Value {{ gift_card.initial_value | money }} · Balance {{ gift_card.balance | money }}</p>
    <p><code>{{ gift_card.code | format_code }}</code></p>
    <p><a href="{{ shop.url }}">Shop at {{ shop.name }}</a></p>
  </body>
</html>
